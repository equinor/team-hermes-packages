  },
  "license": "MIT",
  "author": "Equinor Team Hermes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/equinor/team-hermes-packages.git",
    "directory": "team-hermes-packages-react"
  },
  "style": "dist/style.css",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack && vp exec tailwindcss -i src/styles.css -o dist/style.css",
