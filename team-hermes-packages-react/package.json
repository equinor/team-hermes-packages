    "@tanstack/react-virtual": "^3.14.5",
    "nuqs": "^2.9.0",
    "react-toastify": "^11.1.0",
    "remeda": "^2.39.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
