{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "packages": {
    "team-hermes-packages-react": {
      "release-type": "node",
      "component": "team-hermes-packages-react"
    },
    "team-hermes-packages-python/elasticsearch": {
      "release-type": "python",
      "component": "team-hermes-elasticsearch",
      "extra-files": [
        {
          "type": "toml",
          "path": "/team-hermes-packages-python/uv.lock",
          "jsonpath": "$.package[?(@.name.value == 'team-hermes-elasticsearch')].version"
        }
      ]
    },
    "team-hermes-packages-python/core": {
      "release-type": "python",
      "component": "team-hermes-core",
      "extra-files": [
        {
          "type": "toml",
          "path": "/team-hermes-packages-python/uv.lock",
          "jsonpath": "$.package[?(@.name.value == 'team-hermes-core')].version"
        }
      ]
    },
    "team-hermes-packages-python/query": {
      "release-type": "python",
      "component": "team-hermes-query",
      "extra-files": [
        {
          "type": "toml",
          "path": "/team-hermes-packages-python/uv.lock",
          "jsonpath": "$.package[?(@.name.value == 'team-hermes-query')].version"
        }
      ]
    },
    "team-hermes-packages-python/validation": {
      "release-type": "python",
      "component": "team-hermes-validation",
      "extra-files": [
        {
          "type": "toml",
          "path": "/team-hermes-packages-python/uv.lock",
          "jsonpath": "$.package[?(@.name.value == 'team-hermes-validation')].version"
        }
      ]
    }
  }
}
